package apatoad

import "naphatsite/web/layouts"

templ Page() {
	@layouts.Base(layouts.SmallContentWidth) {
		<div class="flex flex-col gap-4 font-sans">
			<header class="mb-4">
				<div class="mb-4">
					<h1 class="mb-4 text-4xl font-bold tracking">Apato</h1>
					<p class="mb-4 text-xl">
						Apato utilizes 3D visualization in order to give you full information about real estate locations and prices.
					</p>
				</div>
				<div class="text-gray-500 dark:text-neutral-400">
					<apato-logo-wide></apato-logo-wide>
				</div>
			</header>
			<p>
				Right now it is still in a closed development environment at
				<a class="text-blue-500 hover:underline" href="https://dev.apato.no">https://dev.apato.no</a>.
				Contact Naphat Amundsen if you are interested!
			</p>
		</div>
	}
}
